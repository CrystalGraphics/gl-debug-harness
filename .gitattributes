# Text is LF in the repository and on checkout, as CrystalGUI's: gradlew must stay LF to run on Linux, macOS and WSL.
* text eol=lf
# cmd.exe reads a batch file with LF endings wrongly at labels.
*.[bB][aA][tT] text eol=crlf

